# 数据文件（根据需求决定是否忽略）
# backend/data/  # 注意：数据文件可能需要保留，特别是种子数据

# 字体文件（根据需求决定是否忽略）
# backend/dejavu/  # 注意：字体文件可能需要保留

# 健康检查脚本（根据需求决定是否忽略）
# backend/health_check.py  # 注意：健康检查脚本可能需要保留

# 目录树生成脚本（根据需求决定是否忽略）
# backend/tree.py  # 注意：目录树生成脚本可能需要保留

# ===========================================
# 重要说明
# ===========================================

# 以下文件应该被保留（不要忽略）：
# - backend/config.py           # Flask应用配置
# - backend/requirements.txt    # Python依赖
# - frontend/package.json       # Node.js依赖
# - docker-compose.yml          # Docker容器配置
# - frontend/vite.config.js     # Vite构建配置
# - backend/app.py              # Flask应用入口
# - frontend/src/main.js        # Vue应用入口
# - backend/models/             # 数据模型
# - backend/routes/             # API路由
# - backend/services/           # 业务服务
# - backend/utils/              # 工具函数
# - frontend/src/               # 前端源代码
# - backend/APP/                # 应用模块
# - backend/auth/               # 认证相关
# - backend/GPT/                # GPT相关模块
# - backend/security/           # 安全配置
# - frontend/nginx/             # Nginx配置
# - frontend/public/            # 静态资源
# - frontend/src/components/    # Vue组件
# - frontend/src/pages/         # 页面组件
# - frontend/src/router/        # 路由配置
# - frontend/src/utils/         # 工具函数
# - frontend/src/views/         # 视图组件